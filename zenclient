                local targetCFrame = CFrame.lookAt(
                    camera.CFrame.Position,
                    lockedTargetPart.Position
                )
                local alpha = math.clamp(aimHardness / 10, 0.1, 1)
                camera.CFrame = camera.CFrame:Lerp(targetCFrame, alpha)
