        end
        table.clear(flyMutedSounds)
        if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
        if flyAttachment then flyAttachment:Destroy(); flyAttachment = nil end
        if flyAlignOrientation then flyAlignOrientation:Destroy(); flyAlignOrientation = nil end
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            if flyOldAutoRotate ~= nil then
                humanoid.AutoRotate = flyOldAutoRotate
                flyOldAutoRotate = nil
            end
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end

    local function startFly()
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then
            flyEnabled = false
            return
        end
        stopFly()
        -- Silence character sounds while flying and restore their original volumes when disabled.
        local function muteCharacterSound(instance)
            if instance:IsA("Sound") and flyMutedSounds[instance] == nil then
                flyMutedSounds[instance] = instance.Volume
                instance.Volume = 0
            end
        end
        for _, instance in ipairs(character:GetDescendants()) do
            muteCharacterSound(instance)
        end
        flySoundConnection = character.DescendantAdded:Connect(muteCharacterSound)

        flyAttachment = Instance.new("Attachment")
        flyAttachment.Name = "ZenClientFlyAttachment"
        flyAttachment.Parent = root
        flyVelocity = Instance.new("LinearVelocity")
        flyVelocity.Name = "ZenClientFlyVelocity"
        flyVelocity.Attachment0 = flyAttachment
        flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        flyVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        flyVelocity.MaxForce = math.huge
        flyVelocity.VectorVelocity = Vector3.zero
        flyVelocity.Parent = root

        -- Keep the avatar upright without PlatformStand, which can leave the
        -- character lying sideways. The camera controls facing and flight direction.
        flyOldAutoRotate = humanoid.AutoRotate
        humanoid.AutoRotate = false
        humanoid.PlatformStand = false

        flyAlignOrientation = Instance.new("AlignOrientation")
        flyAlignOrientation.Name = "ZenClientFlyUpright"
        flyAlignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        flyAlignOrientation.Attachment0 = flyAttachment
        flyAlignOrientation.RigidityEnabled = false
        flyAlignOrientation.Responsiveness = 35
        flyAlignOrientation.MaxTorque = math.huge
        flyAlignOrientation.Parent = root

        flyConnection = RunService.RenderStepped:Connect(function()
            if not flyEnabled or not root.Parent or not humanoid.Parent then
                stopFly()
                return
            end

            local camera = workspace.CurrentCamera
            if not camera then return end

            -- Convert the normal movement input into camera-local directions,
            -- then use the camera's full look vector so aiming up/down affects flight.
            local moveDirection = humanoid.MoveDirection
            local localMove = camera.CFrame:VectorToObjectSpace(moveDirection)
            local cameraMove = (camera.CFrame.RightVector * localMove.X)
                + (camera.CFrame.LookVector * -localMove.Z)

            local vertical = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space)
                or UserInputService:IsKeyDown(Enum.KeyCode.ButtonA) then
                vertical += flySpeed
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                or UserInputService:IsKeyDown(Enum.KeyCode.ButtonB) then
                vertical -= flySpeed
            end

            local flightDirection = cameraMove * flySpeed + Vector3.new(0, vertical, 0)
            flyVelocity.VectorVelocity = flightDirection

            -- Face the horizontal camera direction while keeping the body upright.
            local look = camera.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude > 0.001 then
                flyAlignOrientation.CFrame = CFrame.lookAt(
                    Vector3.zero,
                    flatLook.Unit,
                    Vector3.yAxis
                )
            end
        end)
    end

    local function setFlyEnabled(enabled)
        flyEnabled = enabled
        if enabled then startFly() else stopFly() end
        local active = flyEnabled
        TweenService:Create(flySwitch, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = active and Color3.fromRGB(100, 35, 175) or Color3.fromRGB(55, 35, 75)
        }):Play()
        TweenService:Create(flySwitchKnob, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = active and UDim2.new(1, -12, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
            BackgroundColor3 = active and COLORS.White or COLORS.LightPurple
        }):Play()
        flySwitchStroke.Color = active and COLORS.LightPurple or COLORS.NeonPurple
        flyRowStroke.Color = active and COLORS.NeonPurple or COLORS.Purple
        flyLabel.TextColor3 = active and COLORS.White or COLORS.LightPurple
        flyLabel.Text = active and "Fly: ON" or "Fly"
    end
    flySwitch.Activated:Connect(function()
        setFlyEnabled(not flyEnabled)
    end)
    player.CharacterAdded:Connect(function(character)
        if flyEnabled then
            local humanoid = character:WaitForChild("Humanoid", 5)
            local root = character:WaitForChild("HumanoidRootPart", 5)
            if humanoid and root and flyEnabled then
                task.wait(0.2)
                startFly()
            end
        end
    end)

end

end


