                        active[op]=true
                    else line.Visible=false end
                else line.Visible=false end
            else
                local line=playerLines[op]; if line then line.Visible=false end
            end
        end
    end
    for op,line in pairs(playerLines) do
        if not op.Parent or op==player then if line then line:Destroy() end; playerLines[op]=nil
        elseif not active[op] and line and line.Parent then line.Visible=false end
    end
end
