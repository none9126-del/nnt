    local function startAimLock()
        local firstTarget = findClosestToScreenCenter()

        if not firstTarget then
            aimEnabled = true
            lockedTargetPart = nil
            lockCircle.Visible = true
            updateLockCircle()
        else
            aimEnabled = true
            lockedTargetPart = firstTarget
            lockCircle.Visible = true
            updateLockCircle()
        end

        RunService:UnbindFromRenderStep(AIM_RENDER_BIND)

        RunService:BindToRenderStep(
            AIM_RENDER_BIND,
            Enum.RenderPriority.Camera.Value + 1,
            function()
                if not aimEnabled then
                    RunService:UnbindFromRenderStep(AIM_RENDER_BIND)
                    return
                end

                local camera = workspace.CurrentCamera
                if not camera then return end

                updateLockCircle()

                if not lockedTargetPart
                    or not lockedTargetPart.Parent
                    or not lockedTargetPart:IsDescendantOf(workspace) then
                    lockedTargetPart = findClosestToScreenCenter()
                end

                if not lockedTargetPart then
                    return
                end

                local character =
                    lockedTargetPart:FindFirstAncestorOfClass("Model")
                local humanoid = character
                    and character:FindFirstChildOfClass("Humanoid")

                if not humanoid or humanoid.Health <= 0 then
                    lockedTargetPart = nil
                    return
