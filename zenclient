                adornment.Name = "ZenClientESPBoxVisual"
                adornment.Adornee = root
                adornment.AlwaysOnTop = true
                adornment.ZIndex = 10
                adornment.Color3 = Color3.fromRGB(190, 80, 255)
                adornment.Transparency = 0.48
                adornment.Parent = root
                boxAdornments[character] = adornment

                -- A transparent proxy follows the character bounds so the black
                -- SelectionBox outlines the same tall, narrow box as the purple fill.
                local proxy = Instance.new("Part")
                proxy.Name = "ZenClientESPBoxOutlineProxy"
                proxy.Transparency = 1
                proxy.Anchored = false
                proxy.CanCollide = false
                proxy.CanTouch = false
                proxy.CanQuery = false
                proxy.Massless = true
                proxy.CastShadow = false
                proxy.Size = Vector3.new(2, 5, 1)
                proxy.CFrame = root.CFrame
                proxy.Parent = character
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = root
                weld.Part1 = proxy
                weld.Parent = proxy
                local outline = Instance.new("SelectionBox")
                outline.Name = "ZenClientESPBoxBlackOutline"
                outline.Adornee = proxy
                outline.Color3 = Color3.fromRGB(0, 0, 0)
                outline.LineThickness = 0.035
                outline.SurfaceTransparency = 1
                outline.Transparency = 0
                outline.Parent = proxy
                boxOutlines[character] = outline
