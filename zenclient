local function updateLine()
    local cam=workspace.CurrentCamera
    if not enabled or not cam then hideAllPlayerLines(); return end
    local sz=cam.ViewportSize
    local center=Vector2.new(sz.X/2,sz.Y/2)
    local active={}
    for _,op in ipairs(Players:GetPlayers()) do
        if op~=player then
            local ch=op.Character
            local h=ch and ch:FindFirstChildOfClass('Humanoid')
            local r=ch and ch:FindFirstChild('HumanoidRootPart')
            if h and h.Health>0 and r and r:IsA('BasePart') then
                local pt,on=cam:WorldToViewportPoint(r.Position)
                local line=getPlayerLine(op)
                if on and pt.Z>0 then
                    local target=Vector2.new(pt.X,pt.Y)
                    local delta=target-center
                    local len=delta.Magnitude
                    if len>=1 then
                        local midpoint=(center+target)/2
                        line.Position=UDim2.fromOffset(midpoint.X,midpoint.Y)
                        line.Size=UDim2.fromOffset(len,thickness)
                        line.Rotation=math.deg(math.atan2(delta.Y,delta.X))
