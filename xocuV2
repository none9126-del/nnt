function FormatUptime(s)
    local h = s // 3600
    local m = (s % 3600) // 60
    local sc = s % 60

    if h > 0 then
        return('%dh %02dm'):format(h, m)
    elseif m > 0 then
        return('%dm %02ds'):format(m, sc)
    else
        return sc .. 's'
    end
end

