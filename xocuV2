                if os.clock() - sData.lastCallTime >= CooldownTime then
                    sData.isFlagged = false

                    break
                end

                task.wait(0.5)
            end

            isLagging = false
            suspectPlayer = nil

            UpdateCharBeamState()
        end)
    else
