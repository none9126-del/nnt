                local myLA = myChar:FindFirstChild("Left Arm")
                local myRA = myChar:FindFirstChild("Right Arm")
                local myLL = myChar:FindFirstChild("Left Leg")
                local myLR = myChar:FindFirstChild("Right Leg")

